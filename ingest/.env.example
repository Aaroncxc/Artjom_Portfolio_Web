# Google Drive API Configuration
GOOGLE_DRIVE_FOLDER_ID=your_folder_id_here
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account.json

# Or use inline credentials (JSON string)
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# Storage Configuration (choose one)
STORAGE_PROVIDER=local
# STORAGE_PROVIDER=s3
# STORAGE_PROVIDER=r2
# STORAGE_PROVIDER=gcs

# S3/R2 Configuration (if using S3-compatible storage)
# S3_BUCKET=your-bucket-name
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
# S3_ENDPOINT=https://your-r2-account.r2.cloudflarestorage.com (for R2)

# GCS Configuration (if using Google Cloud Storage)
# GCS_BUCKET=your-bucket-name
# GCS_PROJECT_ID=your-project-id

# Output paths
OUTPUT_POSTS_JSON=../public/posts.json
OUTPUT_PROJECTS_DIR=../public/projects
OUTPUT_ASSETS_DIR=../public/assets

# CDN URL prefix for assets (used in posts.json URLs)
ASSETS_CDN_URL=https://cdn.multikunst.com/assets
